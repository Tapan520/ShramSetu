@page
@model ShramSetu.Pages.Admin.FeatureFlagsModel
@{ ViewData["Title"] = "Feature Flags"; }
<h2 class="mb-4"><i class="bi bi-toggles me-2"></i>Feature Flags</h2>
<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Add / Update Flag</div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-2">
                        <label asp-for="Input.Name" class="form-label">Flag Name (camelCase)</label>
                        <input asp-for="Input.Name" class="form-control" placeholder="EnableJobAlerts" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <input asp-for="Input.Description" class="form-control" placeholder="What does this flag do?" />
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input asp-for="Input.Enabled" class="form-check-input" role="switch" />
                        <label asp-for="Input.Enabled" class="form-check-label">Enabled</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save Flag</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">All Flags</div>
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Flag Name</th><th>Description</th><th>Status</th><th>Updated</th></tr></thead>
                <tbody>
                    @foreach (var f in Model.Flags)
                    {
                        <tr>
                            <td><code>@f.Name</code></td>
                            <td><small>@f.Description</small></td>
                            <td>
                                <form method="post" asp-page-handler="Toggle" class="d-inline">
                                    <input type="hidden" name="id" value="@f.Id" />
                                    <input type="hidden" name="enable" value="@(f.Status == Core.Enums.FeatureFlagStatus.Disabled)" />
                                    <button type="submit" class="btn btn-sm @(f.Status == Core.Enums.FeatureFlagStatus.Enabled ? "btn-success" : "btn-outline-secondary")">
                                        @(f.Status == Core.Enums.FeatureFlagStatus.Enabled ? "ON" : "OFF")
                                    </button>
                                </form>
                            </td>
                            <td><small class="text-muted">@f.UpdatedAt.ToLocalTime().ToString("dd MMM HH:mm")</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
