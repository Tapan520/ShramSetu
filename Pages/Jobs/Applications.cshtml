@page "{id:guid}"
@model ShramSetu.Pages.Jobs.ApplicationsModel
@{
    ViewData["Title"] = $"Applications  {Model.Job?.Title}";
}

@if (Model.Job is null)
{
    <div class="alert alert-warning">Job not found.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Applications</h2>
            <p class="text-muted mb-0">@Model.Job.Title  @Model.Applications.Count applicant(s)</p>
        </div>
        <a asp-page="/Jobs/Detail" asp-route-id="@Model.Job.Id"
           class="btn btn-outline-secondary btn-sm">? Back to Job</a>
    </div>

    @if (!Model.Applications.Any())
    {
        <div class="alert alert-info">No applications yet.</div>
    }
    else
    {
        @foreach (var app in Model.Applications)
        {
            var borderClass = app.Status switch
            {
                ShramSetu.Core.Enums.JobApplicationStatus.Accepted    => "border-success",
                ShramSetu.Core.Enums.JobApplicationStatus.Shortlisted => "border-info",
                ShramSetu.Core.Enums.JobApplicationStatus.Rejected    => "border-danger",
                _ => "border-secondary"
            };
            <div class="card mb-3 shadow-sm @borderClass" style="border-left-width:4px !important">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-2">
                                @if (!string.IsNullOrEmpty(app.Worker.PhotoUrl))
                                {
                                    <img src="@app.Worker.PhotoUrl" class="rounded-circle me-2"
                                         width="40" height="40" style="object-fit:cover" alt="" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle fs-2 me-2 text-secondary"></i>
                                }
                                <div>
                                    <strong>@app.Worker.FullName</strong>
                                    <div class="small text-muted">@app.Worker.Phone  @(app.Worker.LocationCity ?? "")</div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(app.CoverNote))
                            {
                                <p class="small mb-1"><em>"@app.CoverNote"</em></p>
                            }
                            <p class="small text-muted mb-0">
                                Applied @app.AppliedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                            </p>
                        </div>
                        <div class="col-md-3 mt-2 mt-md-0">
                            <a asp-page="/Workers/Profile" asp-route-id="@app.Worker.Id"
                               class="btn btn-outline-primary btn-sm w-100 mb-2">View Profile</a>
                        </div>
                        <div class="col-md-3 mt-2 mt-md-0">
                            <form method="post">
                                <input type="hidden" name="applicationId" value="@app.Id" />
                                <div class="d-flex flex-column gap-1">
                                    <button name="action" value="Shortlisted" class="btn btn-info btn-sm">Shortlist</button>
                                    <button name="action" value="Accepted"    class="btn btn-success btn-sm">Accept</button>
                                    <button name="action" value="Rejected"    class="btn btn-danger btn-sm">Reject</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
}
