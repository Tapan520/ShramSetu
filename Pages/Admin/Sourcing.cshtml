@page
@model ShramSetu.Pages.Admin.SourcingModel
@{
    ViewData["Title"] = "Admin  Sourcing Requests";
}

<h2 class="mb-4"><i class="bi bi-card-checklist me-2"></i>Sourcing Requests</h2>

<ul class="nav nav-tabs mb-3">
    @foreach (var s in new[] { "Open", "InProgress", "Fulfilled", "Cancelled" })
    {
        <li class="nav-item">
            <a class="nav-link @(Model.StatusFilter == s ? "active" : "")"
               asp-page="/Admin/Sourcing" asp-route-statusFilter="@s">@s</a>
        </li>
    }
</ul>

@if (!Model.Requests.Any())
{
    <div class="alert alert-info">No requests in this status.</div>
}
else
{
    @foreach (var req in Model.Requests)
    {
        <div class="card mb-3 shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <strong>@req.SkillCategory.Name</strong>
                     @req.WorkerCount worker(s) for @req.DurationDays day(s)
                </span>
                <span class="text-muted small">@req.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <p>@req.Description</p>
                        <ul class="list-unstyled small">
                            <li><i class="bi bi-geo-alt me-1"></i>@(req.LocationCity ?? ""), @(req.LocationState ?? "")</li>
                            <li><i class="bi bi-cash me-1"></i>Budget: &#8377;@req.BudgetPerDay / day</li>
                            <li><i class="bi bi-telephone me-1"></i>@req.Employer.Phone</li>
                        </ul>
                    </div>
                    <div class="col-md-4">
                        <form method="post">
                            <input type="hidden" name="requestId" value="@req.Id" />
                            <div class="mb-2">
                                <textarea name="adminNotes" class="form-control form-control-sm" rows="2"
                                          placeholder="Admin notes">@req.AdminNotes</textarea>
                            </div>
                            <div class="btn-group btn-group-sm w-100">
                                <button name="action" value="InProgress" class="btn btn-warning">In Progress</button>
                                <button name="action" value="Fulfilled" class="btn btn-success">Fulfilled</button>
                                <button name="action" value="Cancelled" class="btn btn-danger">Cancel</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
