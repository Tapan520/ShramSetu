@page
@model ShramSetu.Pages.Workers.AvailabilityModel
@{
    ViewData["Title"] = "My Availability Calendar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-calendar3 me-2"></i>My Availability</h2>
</div>

<div class="row g-4">
    <!-- Add slot form -->
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Add / Block Dates</div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Input.StartDate" class="form-label"></label>
                        <input asp-for="Input.StartDate" type="date" class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Input.StartDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.EndDate" class="form-label"></label>
                        <input asp-for="Input.EndDate" type="date" class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Input.EndDate" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.SlotType" class="form-label">Type</label>
                        <select asp-for="Input.SlotType" class="form-select">
                            <option value="Available">? Available</option>
                            <option value="Unavailable">?? Unavailable</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Note" class="form-label"></label>
                        <input asp-for="Input.Note" class="form-control" placeholder="Optional note" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-plus-circle me-1"></i> Save Slot
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Calendar and slots list -->
    <div class="col-md-8">
        <div id="calendar" class="mb-4" style="min-height:300px"></div>

        <h5 class="border-bottom pb-2">Upcoming Slots</h5>
        @if (!Model.Slots.Any())
        {
            <p class="text-muted">No availability slots set. Add some using the form.</p>
        }
        else
        {
            @foreach (var slot in Model.Slots)
            {
                var (bg, icon) = slot.SlotType.ToString() == "Available"
                    ? ("bg-success-subtle border-success", "bi-check-circle-fill text-success")
                    : ("bg-danger-subtle border-danger", "bi-x-circle-fill text-danger");
                <div class="d-flex justify-content-between align-items-center p-2 mb-2 rounded border @bg">
                    <div>
                        <i class="bi @icon me-2"></i>
                        <strong>@slot.StartDate.ToString("dd MMM")</strong> ? <strong>@slot.EndDate.ToString("dd MMM yyyy")</strong>
                        <span class="badge ms-2 @(slot.SlotType.ToString() == "Available" ? "bg-success" : "bg-danger")">@slot.SlotType</span>
                        @if (!string.IsNullOrEmpty(slot.Note))
                        {
                            <small class="text-muted ms-2">@slot.Note</small>
                        }
                    </div>
                    <form method="post" asp-page-handler="Delete">
                        <input type="hidden" name="slotId" value="@slot.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var calendarEl = document.getElementById('calendar');
            var events = @Html.Raw(Model.CalendarEventsJson);
            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: { left: 'prev,next today', center: 'title', right: 'dayGridMonth,listMonth' },
                events: events,
                height: 400
            });
            calendar.render();
        });
    </script>
}
