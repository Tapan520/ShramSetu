@page
@model ShramSetu.Pages.Workers.WalletModel
@{ ViewData["Title"] = "My Earnings Wallet"; }
<h2 class="mb-4"><i class="bi bi-wallet2 me-2 text-success"></i>My Earnings Wallet</h2>
<div class="row g-4">
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body text-center py-4">
                <p class="mb-1">Current Balance</p>
                <h2 class="display-5 fw-bold">&#8377;@Model.Balance.ToString("N2")</h2>
            </div>
        </div>
        <div class="card shadow-sm mt-3">
            <div class="card-header fw-semibold">Bank / UPI Details</div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-2">
                        <label class="form-label small">UPI ID</label>
                        <input asp-for="Input.UpiId" class="form-control form-control-sm" placeholder="example@upi" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Bank Account No.</label>
                        <input asp-for="Input.BankAccountNumber" class="form-control form-control-sm" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small">IFSC Code</label>
                        <input asp-for="Input.IfscCode" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm w-100">Save</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <h5 class="border-bottom pb-2">Recent Transactions</h5>
        @if (!Model.Transactions.Any())
        {
            <p class="text-muted">No transactions yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light"><tr><th>Date</th><th>Type</th><th>Description</th><th class="text-end">Amount</th><th class="text-end">Balance</th></tr></thead>
                    <tbody>
                        @foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td>@t.TransactedAt.ToLocalTime().ToString("dd MMM yy")</td>
                                <td><span class="badge @(t.Type == Core.Enums.WalletTransactionType.Credit ? "bg-success" : "bg-danger")">@t.Type</span></td>
                                <td>@t.Description</td>
                                <td class="text-end @(t.Type == Core.Enums.WalletTransactionType.Credit ? "text-success" : "text-danger")">
                                    @(t.Type == Core.Enums.WalletTransactionType.Credit ? "+" : "-")&#8377;@t.Amount.ToString("N2")
                                </td>
                                <td class="text-end">&#8377;@t.BalanceAfter.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
