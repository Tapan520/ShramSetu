@page
@model LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-1">
                    <i class="bi bi-people-fill text-primary me-2"></i>ShramSetu
                </h2>
                <p class="text-center text-muted mb-4">Sign in to your account</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control"
                               autocomplete="username" placeholder="Email or phone@worker.shramsetu.in" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Input.Password" id="passwordInput" class="form-control"
                                   autocomplete="current-password" placeholder="" />
                            <button class="btn btn-outline-secondary" type="button"
                                    onclick="togglePwd()" title="Show/hide password">
                                <i class="bi bi-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>
                </form>

                <hr />

                <div class="text-center">
                    <a asp-page="./ForgotPassword" class="small">Forgot your password?</a>
                </div>
                <div class="text-center mt-2">
                    <span class="text-muted small">Don't have an account?</span>
                    <a asp-page="/Register/Worker" class="small ms-1">Register as Worker</a>
                    &nbsp;|&nbsp;
                    <a asp-page="/Register/Employer" class="small">Register as Employer</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePwd() {
            var inp = document.getElementById('passwordInput');
            var ico = document.getElementById('eyeIcon');
            if (inp.type === 'password') {
                inp.type = 'text';
                ico.className = 'bi bi-eye-slash';
            } else {
                inp.type = 'password';
                ico.className = 'bi bi-eye';
            }
        }
    </script>
}
