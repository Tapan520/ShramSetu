@page
@model ShramSetu.Pages.Admin.SkillCategoriesModel
@{ ViewData["Title"] = "Skill Categories"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-tags me-2"></i>Skill Categories</h2>
</div>
<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">@(Model.Input.Id == Guid.Empty ? "Add New Category" : "Edit Category")</div>
            <div class="card-body">
                <form method="post">
                    <input type="hidden" asp-for="Input.Id" />
                    <div class="mb-2">
                        <label asp-for="Input.Name" class="form-label"></label>
                        <input asp-for="Input.Name" class="form-control" placeholder="e.g. Mason" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.IconCssClass" class="form-label">Bootstrap Icon Class</label>
                        <input asp-for="Input.IconCssClass" class="form-control" placeholder="bi bi-hammer" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save</button>
                    @if (Model.Input.Id != Guid.Empty)
                    {
                        <a asp-page="/Admin/SkillCategories" class="btn btn-link w-100">Cancel Edit</a>
                    }
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">All Skill Categories (@Model.Categories.Count)</div>
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Icon</th><th>Name</th><th>Workers</th><th>Active Jobs</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in Model.Categories)
                    {
                        <tr>
                            <td><i class="@c.IconCssClass fs-4 text-primary"></i></td>
                            <td>@c.Name</td>
                            <td>@c.WorkerCount</td>
                            <td>@c.JobCount</td>
                            <td>
                                <a asp-page="/Admin/SkillCategories" asp-route-editId="@c.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form method="post" asp-page-handler="Delete" class="d-inline">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete @c.Name?')">Del</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
