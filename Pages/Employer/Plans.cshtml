@page
@model ShramSetu.Pages.Employer.PlansModel
@{
    ViewData["Title"] = "Subscription Plans";
}

<h2 class="mb-2 text-center"><i class="bi bi-gem me-2"></i>Subscription Plans</h2>
<p class="text-center text-muted mb-5">Upgrade to unlock more job posts, chat, analytics and priority support.</p>

@if (Model.ActiveSubscription is not null)
{
    <div class="alert alert-success text-center mb-5">
        <i class="bi bi-check-circle-fill me-2"></i>
        You are on the <strong>@Model.ActiveSubscription.Plan.Name</strong> plan,
        active until <strong>@Model.ActiveSubscription.EndDate.ToString("dd MMM yyyy")</strong>.
    </div>
}

<div class="row row-cols-1 row-cols-md-4 g-4 justify-content-center mb-5">
    @foreach (var plan in Model.Plans)
    {
        var featured = plan.Tier == ShramSetu.Core.Enums.SubscriptionTier.Pro;
        <div class="col">
            <div class="card h-100 shadow @(featured ? "border-primary border-2" : "")">
                @if (featured)
                {
                    <div class="card-header bg-primary text-white text-center fw-bold">Most Popular</div>
                }
                <div class="card-body text-center">
                    <h4 class="card-title">@plan.Name</h4>
                    <p class="display-6 fw-bold">&#8377;@plan.PriceMonthly<small class="fs-6 fw-normal">/mo</small></p>
                    <p class="text-muted small">or &#8377;@plan.PriceYearly/yr (save ~@(plan.PriceMonthly > 0 ? (int)(100 - plan.PriceYearly * 100 / (plan.PriceMonthly * 12)) : 0)%)</p>
                    <ul class="list-unstyled text-start mt-3">
                        <li><i class="bi bi-check-circle text-success me-2"></i>@(plan.MaxJobPosts == -1 ? "Unlimited" : plan.MaxJobPosts.ToString()) job posts</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>@(plan.MaxSourcingRequests == -1 ? "Unlimited" : plan.MaxSourcingRequests.ToString()) sourcing requests/mo</li>
                        @if (plan.CanAccessChat)
                        {
                            <li><i class="bi bi-check-circle text-success me-2"></i>In-app chat</li>
                        }
                        @if (plan.CanAccessAnalytics)
                        {
                            <li><i class="bi bi-check-circle text-success me-2"></i>Analytics dashboard</li>
                        }
                        @if (plan.PrioritySupport)
                        {
                            <li><i class="bi bi-check-circle text-success me-2"></i>Priority support</li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-transparent">
                    @if (plan.PriceMonthly == 0)
                    {
                        <button class="btn btn-outline-secondary w-100" disabled>Current Free Plan</button>
                    }
                    else
                    {
                        <form method="post">
                            <input type="hidden" name="planId" value="@plan.Id" />
                            <input type="hidden" name="yearly" value="false" />
                            <button type="submit" class="btn @(featured ? "btn-primary" : "btn-outline-primary") w-100">
                                Subscribe Monthly
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>
