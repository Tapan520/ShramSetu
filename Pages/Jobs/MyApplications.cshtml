@page
@model ShramSetu.Pages.Jobs.MyApplicationsModel
@{
    ViewData["Title"] = "My Applications";
}

<h2 class="mb-4"><i class="bi bi-file-earmark-text me-2"></i>My Applications</h2>

@if (!Model.Applications.Any())
{
    <div class="alert alert-info">
        You haven't applied to any jobs yet.
        <a asp-page="/Jobs/Index">Browse open jobs</a>.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Job</th>
                    <th>Skill</th>
                    <th>Employer</th>
                    <th>Wage/Day</th>
                    <th>Start</th>
                    <th>Applied</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model.Applications)
                {
                    var badgeClass = app.Status switch
                    {
                        ShramSetu.Core.Enums.JobApplicationStatus.Accepted    => "bg-success",
                        ShramSetu.Core.Enums.JobApplicationStatus.Shortlisted => "bg-info text-dark",
                        ShramSetu.Core.Enums.JobApplicationStatus.Rejected    => "bg-danger",
                        ShramSetu.Core.Enums.JobApplicationStatus.Withdrawn   => "bg-secondary",
                        _                                                      => "bg-warning text-dark"
                    };
                    <tr>
                        <td><a asp-page="/Jobs/Detail" asp-route-id="@app.JobPost.Id">@app.JobPost.Title</a></td>
                        <td>@app.JobPost.SkillCategory.Name</td>
                        <td>@app.JobPost.Employer.Name</td>
                        <td>&#8377;@app.JobPost.DailyWage</td>
                        <td>@app.JobPost.StartDate.ToString("dd MMM yy")</td>
                        <td>@app.AppliedAt.ToLocalTime().ToString("dd MMM yy")</td>
                        <td><span class="badge @badgeClass">@app.Status</span></td>
                        <td>
                            @if (app.Status == ShramSetu.Core.Enums.JobApplicationStatus.Applied
                              || app.Status == ShramSetu.Core.Enums.JobApplicationStatus.Shortlisted)
                            {
                                <form method="post">
                                    <input type="hidden" name="applicationId" value="@app.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Withdraw</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
