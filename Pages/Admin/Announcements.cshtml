@page
@model ShramSetu.Pages.Admin.AnnouncementsModel
@{ ViewData["Title"] = "Announcements"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-megaphone me-2"></i>Announcements</h2>
</div>
<div class="row g-4">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">New Announcement</div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 d-none"></div>
                    <div class="mb-2">
                        <label asp-for="Input.Title" class="form-label"></label>
                        <input asp-for="Input.Title" class="form-control" />
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Body" class="form-label"></label>
                        <textarea asp-for="Input.Body" rows="3" class="form-control"></textarea>
                    </div>
                    <div class="mb-2">
                        <label asp-for="Input.Target" class="form-label"></label>
                        <select asp-for="Input.Target" class="form-select">
                            @foreach (var t in Enum.GetNames<ShramSetu.Core.Enums.AnnouncementTarget>())
                            { <option value="@t">@t</option> }
                        </select>
                    </div>
                    <div class="mb-2 d-flex gap-3">
                        <div class="form-check"><input asp-for="Input.ShowBanner" class="form-check-input" /><label asp-for="Input.ShowBanner" class="form-check-label">Show Banner</label></div>
                        <div class="form-check"><input asp-for="Input.SendPush" class="form-check-input" /><label asp-for="Input.SendPush" class="form-check-label">Push</label></div>
                        <div class="form-check"><input asp-for="Input.SendSms" class="form-check-input" /><label asp-for="Input.SendSms" class="form-check-label">SMS</label></div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.ExpiresAt" class="form-label"></label>
                        <input asp-for="Input.ExpiresAt" type="datetime-local" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Publish</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Published Announcements</div>
            <ul class="list-group list-group-flush">
                @foreach (var a in Model.Announcements)
                {
                    <li class="list-group-item">
                    <div class="d-flex justify-content-between align-items-start">
                            <strong>
                                @{
                                    var icon = a.Target.ToString() switch {
                                        "Workers"   => "bi bi-person-arms-up text-warning me-2",
                                        "Employers" => "bi bi-building text-info me-2",
                                        _           => "bi bi-megaphone text-danger me-2"
                                    };
                                }
                                <i class="@icon"></i>@a.Title
                            </strong>
                            <span class="badge @(a.BannerCssClass switch {
                                "alert-info"    => "bg-info text-dark",
                                "alert-warning" => "bg-warning text-dark",
                                "alert-danger"  => "bg-danger",
                                _               => "bg-secondary"
                            })">@a.Target</span>
                        </div>
                        <small class="text-muted">@a.Body</small>
                        <div class="mt-1"><small class="text-muted">@a.CreatedAt.ToLocalTime().ToString("dd MMM HH:mm")  Expires: @(a.ExpiresAt?.ToLocalTime().ToString("dd MMM") ?? "Never")</small></div>
                    </li>
                }
                @if (!Model.Announcements.Any()) { <li class="list-group-item text-muted">No announcements yet.</li> }
            </ul>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
