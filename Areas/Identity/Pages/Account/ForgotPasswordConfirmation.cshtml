@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset Link Sent";
}
<div class="row justify-content-center mt-5">
    <div class="col-md-5 text-center">
        <i class="bi bi-envelope-check text-success" style="font-size:4rem;"></i>
        <h3 class="mt-3">Check your inbox</h3>
        <p class="text-muted">If an account with that email exists, a password reset link has been sent.</p>
        <a asp-page="./Login" class="btn btn-primary mt-2">Back to Login</a>
    </div>
</div>
