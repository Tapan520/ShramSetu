@page
@model ShramSetu.Pages.SuperAdmin.ActiveSessionsModel
@{ ViewData["Title"] = "Active Sessions"; }

<div class="ss-page-header d-flex justify-content-between align-items-center">
    <div>
        <h3><i class="bi bi-activity text-success me-2"></i>Active Sessions</h3>
        <p class="text-muted mb-0">Real-time view of currently logged-in users</p>
    </div>
    <span class="badge bg-success fs-6 px-3 py-2">
        <i class="bi bi-circle-fill me-1" style="font-size:.55rem"></i>@Model.Sessions.Count online
    </span>
</div>

@if (!Model.Sessions.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>No active sessions at the moment.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>IP Address</th>
                        <th>Login Time</th>
                        <th>Last Active</th>
                        <th>Status</th>
                        <th>Browser / User Agent</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int idx = 1; }
                    @foreach (var s in Model.Sessions)
                    {
                        var roleBadge = s.Role switch {
                            "SuperAdmin" => "bg-danger",
                            "Admin"      => "bg-warning text-dark",
                            "Employer"   => "bg-info text-dark",
                            "Worker"     => "bg-success",
                            _            => "bg-secondary"
                        };
                        var minutesAgo = (DateTime.UtcNow - s.LastActive).TotalMinutes;
                        var activeClass = minutesAgo < 5 ? "text-success fw-semibold" : "text-muted";

                        <tr>
                            <td class="text-muted">@(idx++)</td>
                            <td>
                                <i class="bi bi-person-circle me-1 text-muted"></i>
                                <strong>@s.Email</strong>
                            </td>
                            <td><span class="badge @roleBadge">@(string.IsNullOrEmpty(s.Role) ? "—" : s.Role)</span></td>
                            <td><code class="small">@s.IpAddress</code></td>
                            <td><small>@s.LoginTime.ToLocalTime().ToString("dd MMM yyyy HH:mm")</small></td>
                            <td class="@activeClass">
                                <small>
                                    @if (minutesAgo < 1)
                                    { <span>Just now</span> }
                                    else if (minutesAgo < 60)
                                    { <span>@((int)minutesAgo)m ago</span> }
                                    else
                                    { <span>@((int)(minutesAgo / 60))h ago</span> }
                                </small>
                            </td>
                            <td>
                                @if (minutesAgo < 5)
                                { <span class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size:.55rem"></i>Active</span> }
                                else
                                { <span class="badge bg-secondary">Idle</span> }
                            </td>
                            <td>
                                <small class="text-muted" title="@s.UserAgent">
                                    @(s.UserAgent.Length > 70 ? s.UserAgent[..70] + "…" : s.UserAgent)
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script>
    // Auto-refresh every 30 seconds
    setTimeout(() => location.reload(), 30000);
</script>
}
