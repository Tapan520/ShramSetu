@page
@model ShramSetu.Pages.Account.BookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<h2 class="mb-4"><i class="bi bi-calendar-check me-2"></i>My Bookings</h2>

@if (!Model.Bookings.Any())
{
    <div class="alert alert-info">You have no bookings yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Worker</th>
                    <th>Skill</th>
                    <th>Start Date</th>
                    <th>Duration</th>
                    <th>Wage/Day</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Review</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model.Bookings)
                {
                    <tr>
                        <td><a asp-page="/Workers/Profile" asp-route-id="@b.WorkerId">@b.Worker.FullName</a></td>
                        <td>@b.Worker.SkillCategory.Name</td>
                        <td>@b.StartDate.ToString("dd MMM yyyy")</td>
                        <td>@b.DurationDays day(s)</td>
                        <td>&#8377;@b.AgreedWage</td>
                        <td><span class="badge bg-secondary">@b.Type</span></td>
                        <td>
                            @{
                                var cls = b.Status switch
                                {
                                    ShramSetu.Core.Enums.BookingStatus.Completed => "bg-success",
                                    ShramSetu.Core.Enums.BookingStatus.Cancelled => "bg-danger",
                                    ShramSetu.Core.Enums.BookingStatus.InProgress => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @cls">@b.Status</span>
                        </td>
                        <td>
                            @if (b.Status == ShramSetu.Core.Enums.BookingStatus.Completed && b.Review is null)
                            {
                                <a asp-page="/Account/Review" asp-route-bookingId="@b.Id"
                                   class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-star"></i> Leave Review
                                </a>
                            }
                            else if (b.Review is not null)
                            {
                                <span class="text-muted small">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= b.Review.Rating ? "bi-star-fill text-warning" : "bi-star")"></i>
                                    }
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
