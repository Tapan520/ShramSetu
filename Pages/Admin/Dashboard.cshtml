@page
@model ShramSetu.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</h2>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    @{
        var kpis = new[]
        {
            ("Total Workers",    Model.TotalWorkers.ToString(),    "bg-primary",   "bi-people-fill"),
            ("Verified Workers", Model.VerifiedWorkers.ToString(), "bg-success",   "bi-patch-check-fill"),
            ("Pending KYC",      Model.PendingKyc.ToString(),      "bg-warning text-dark", "bi-hourglass-split"),
            ("Total Employers",  Model.TotalEmployers.ToString(),  "bg-info",      "bi-building"),
            ("Active Bookings",  Model.ActiveBookings.ToString(),  "bg-secondary", "bi-calendar2-check"),
            ("Open Jobs",        Model.OpenJobs.ToString(),        "bg-danger",    "bi-briefcase"),
            ("Revenue (Month)",  "&#8377;" + Model.MonthlyRevenue.ToString("N0"), "bg-dark", "bi-currency-rupee"),
            ("Disputes Open",    Model.OpenDisputes.ToString(),    "bg-orange text-dark", "bi-shield-exclamation"),
        };
    }
    @foreach (var (label, value, bg, icon) in kpis)
    {
        <div class="col-6 col-md-3">
            <div class="card text-white @bg shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center py-3">
                    <div>
                        <div class="fs-4 fw-bold">@Html.Raw(value)</div>
                        <small>@label</small>
                    </div>
                    <i class="bi @icon fs-2 opacity-50"></i>
                </div>
            </div>
        </div>
    }
</div>

<!-- Charts Row -->
<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold"><i class="bi bi-graph-up me-2"></i>Bookings  Last 30 Days</div>
            <div class="card-body"><canvas id="bookingsChart" height="100"></canvas></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold"><i class="bi bi-pie-chart me-2"></i>Workers by Skill</div>
            <div class="card-body"><canvas id="skillChart" height="200"></canvas></div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold"><i class="bi bi-bar-chart me-2"></i>Monthly Revenue (&#8377;)</div>
            <div class="card-body"><canvas id="revenueChart" height="120"></canvas></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold"><i class="bi bi-donut me-2"></i>Booking Status Split</div>
            <div class="card-body"><canvas id="statusChart" height="120"></canvas></div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold d-flex justify-content-between">
                <span><i class="bi bi-person-plus me-1"></i>Recent Worker Registrations</span>
                <a asp-page="/Admin/Workers" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var w in Model.RecentWorkers)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@w.FullName</strong>
                            <small class="text-muted ms-2">@w.SkillCategory</small>
                        </div>
                        <span class="badge @(w.KycStatus == "Verified" ? "bg-success" : "bg-warning text-dark")">@w.KycStatus</span>
                    </li>
                }
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header fw-semibold d-flex justify-content-between">
                <span><i class="bi bi-shield-exclamation me-1"></i>Open Disputes</span>
                <a asp-page="/Admin/Disputes" class="btn btn-sm btn-outline-danger">View All</a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var d in Model.RecentDisputes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong>@d.Title</strong>
                            <small class="text-muted ms-2">@d.Type</small>
                        </div>
                        <small class="text-muted">@d.CreatedAt.ToLocalTime().ToString("dd MMM")</small>
                    </li>
                }
                @if (!Model.RecentDisputes.Any())
                {
                    <li class="list-group-item text-muted">No open disputes &#127881;</li>
                }
            </ul>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>
<script>
    // Bookings Line Chart
    new Chart(document.getElementById('bookingsChart'), {
        type: 'line',
        data: {
            labels: @Html.Raw(Model.BookingChartLabelsJson),
            datasets: [{
                label: 'Bookings',
                data: @Html.Raw(Model.BookingChartDataJson),
                borderColor: '#0d6efd', backgroundColor: 'rgba(13,110,253,0.1)',
                tension: 0.4, fill: true
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });

    // Skill Pie Chart
    new Chart(document.getElementById('skillChart'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Model.SkillLabelsJson),
            datasets: [{ data: @Html.Raw(Model.SkillDataJson),
                backgroundColor: ['#0d6efd','#198754','#dc3545','#ffc107','#0dcaf0','#6f42c1','#fd7e14','#20c997','#6610f2','#d63384'] }]
        },
        options: { responsive: true, plugins: { legend: { position: 'right' } } }
    });

    // Revenue Bar Chart
    new Chart(document.getElementById('revenueChart'), {
        type: 'bar',
        data: {
            labels: @Html.Raw(Model.RevenueLabelsJson),
            datasets: [{ label: 'Revenue &#8377;', data: @Html.Raw(Model.RevenueDataJson),
                backgroundColor: '#198754' }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });

    // Status Doughnut
    new Chart(document.getElementById('statusChart'), {
        type: 'doughnut',
        data: {
            labels: @Html.Raw(Model.StatusLabelsJson),
            datasets: [{ data: @Html.Raw(Model.StatusDataJson),
                backgroundColor: ['#ffc107','#0d6efd','#0dcaf0','#198754','#dc3545'] }]
        }
    });
</script>
}
