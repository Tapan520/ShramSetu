@page
@model ShramSetu.Pages.Admin.WorkersModel
@{
    ViewData["Title"] = "Admin  Verify Workers";
}

<h2 class="mb-4"><i class="bi bi-shield-check me-2"></i>Worker Verification Queue</h2>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.StatusFilter == "Pending" ? "active" : "")"
           asp-page="/Admin/Workers" asp-route-statusFilter="Pending">Pending</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.StatusFilter == "UnderReview" ? "active" : "")"
           asp-page="/Admin/Workers" asp-route-statusFilter="UnderReview">Under Review</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.StatusFilter == "Verified" ? "active" : "")"
           asp-page="/Admin/Workers" asp-route-statusFilter="Verified">Verified</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.StatusFilter == "Rejected" ? "active" : "")"
           asp-page="/Admin/Workers" asp-route-statusFilter="Rejected">Rejected</a>
    </li>
</ul>

@if (!Model.Workers.Any())
{
    <div class="alert alert-info">No workers in this status.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Skill</th>
                    <th>Location</th>
                    <th>Documents</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in Model.Workers)
                {
                    <tr>
                        <td>
                            <a asp-page="/Workers/Profile" asp-route-id="@w.Id">@w.FullName</a>
                        </td>
                        <td>@w.Phone</td>
                        <td>@w.SkillCategory.Name</td>
                        <td>@(w.LocationCity ?? ""), @(w.LocationState ?? "")</td>
                        <td>
                            @foreach (var doc in w.Documents)
                            {
                                <a href="@doc.FileUrl" target="_blank" class="badge bg-secondary text-decoration-none me-1">
                                    @doc.Type
                                </a>
                            }
                        </td>
                        <td>
                            @{
                                var badgeClass = w.KycStatus switch
                                {
                                    ShramSetu.Core.Enums.VerificationStatus.Verified => "bg-success",
                                    ShramSetu.Core.Enums.VerificationStatus.Rejected => "bg-danger",
                                    ShramSetu.Core.Enums.VerificationStatus.UnderReview => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@w.KycStatus</span>
                        </td>
                        <td>
                            <form method="post">
                                <input type="hidden" name="workerId" value="@w.Id" />
                                <div class="btn-group btn-group-sm">
                                    <button name="action" value="Verify" class="btn btn-success">
                                        <i class="bi bi-check-lg"></i> Verify
                                    </button>
                                    <button name="action" value="Reject" class="btn btn-danger">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                    <button name="action" value="UnderReview" class="btn btn-warning">
                                        <i class="bi bi-eye"></i> Review
                                    </button>
                                </div>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
