@page
@model ShramSetu.Pages.SuperAdmin.UsersModel
@{ ViewData["Title"] = "User Management"; }

<div class="ss-page-header d-flex justify-content-between align-items-center">
    <div>
        <h3><i class="bi bi-people-fill text-primary me-2"></i>User Management</h3>
        <p class="text-muted mb-0">Add, edit, delete users and manage roles</p>
    </div>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
        <i class="bi bi-person-plus me-1"></i>Add User
    </button>
</div>

<!-- Users Table -->
<div class="card shadow-sm">
    <div class="card-header fw-semibold">
        All Users <span class="badge bg-secondary ms-1">@Model.Users.Count</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th>Change Role</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model.Users)
                {
                    var roleBadge = u.PrimaryRole switch {
                        "SuperAdmin" => "bg-danger",
                        "Admin"      => "bg-warning text-dark",
                        "Employer"   => "bg-info text-dark",
                        "Worker"     => "bg-success",
                        _            => "bg-secondary"
                    };
                    <tr>
                        <td>
                            <i class="bi bi-person-circle me-1 text-muted"></i>
                            <strong>@u.Email</strong>
                            @if (u.Email == User.Identity!.Name)
                            { <span class="badge bg-primary ms-1">You</span> }
                        </td>
                        <td>
                            <span class="text-dark">@u.Name</span>
                        </td>
                        <td>
                            <span class="font-monospace small">@u.Phone</span>
                        </td>
                        <td><span class="badge @roleBadge">@u.PrimaryRole</span></td>
                        <td>
                            @if (u.IsLocked)
                            { <span class="badge bg-danger">Locked</span> }
                            else
                            { <span class="badge bg-success">Active</span> }
                        </td>
                        <td>
                            <form method="post" asp-page-handler="ChangeRole" class="d-flex gap-2">
                                <input type="hidden" name="userId" value="@u.Id" />
                                <select name="newRole" class="form-select form-select-sm" style="width:140px">
                                    <option value="">— No Role —</option>
                                    @foreach (var r in Model.AllRoles)
                                    {
                                        if (u.Roles.Contains(r))
                                        {
                                            <option value="@r" selected>@r</option>
                                        }
                                        else
                                        {
                                            <option value="@r">@r</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-check2"></i>
                                </button>
                            </form>
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <!-- Edit Phone -->
                                <button class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editPhoneModal"
                                        data-userid="@u.Id"
                                        data-email="@u.Email"
                                        data-phone="@u.Phone"
                                        title="Edit Phone">
                                    <i class="bi bi-telephone"></i>
                                </button>
                                <!-- Reset Password -->
                                <button class="btn btn-sm btn-outline-warning"
                                        data-bs-toggle="modal"
                                        data-bs-target="#resetPwdModal"
                                        data-userid="@u.Id"
                                        data-email="@u.Email">
                                    <i class="bi bi-key"></i>
                                </button>
                                <!-- Delete -->
                                @if (u.Email != User.Identity!.Name)
                                {
                                    <form method="post" asp-page-handler="Delete"
                                          onsubmit="return confirm('Delete @u.Email?')">
                                        <input type="hidden" name="userId" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add User Modal -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus me-2"></i>Add New User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small d-none"></div>
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label"></label>
                        <input asp-for="Input.Email" class="form-control" placeholder="user@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label"></label>
                        <input asp-for="Input.Password" type="password" class="form-control" placeholder="Min 8 characters" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Input.Role" class="form-label"></label>
                        <select asp-for="Input.Role" class="form-select">
                            <option value="">— Select Role —</option>
                            @foreach (var r in Model.AllRoles)
                            { <option value="@r">@r</option> }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i>Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPwdModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ResetPassword">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-key me-2"></i>Reset Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="userId" id="resetUserId" />
                    <p class="text-muted small">Resetting password for: <strong id="resetUserEmail"></strong></p>
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input name="newPassword" type="password" class="form-control" placeholder="Min 8 characters" required minlength="8" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-key me-1"></i>Reset Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Phone Modal -->
<div class="modal fade" id="editPhoneModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="UpdatePhone">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-telephone me-2"></i>Edit Phone Number</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="userId" id="editPhoneUserId" />
                    <p class="text-muted small mb-3">Editing phone for: <strong id="editPhoneEmail"></strong></p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mobile Number</label>
                        <input name="newPhone" id="editPhoneInput" type="tel" class="form-control"
                               placeholder="10-digit mobile number" required maxlength="15" />
                        <div class="form-text">This will update the phone number across Identity, Worker & Employer profiles.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2 me-1"></i>Save Phone
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    // Populate reset password modal
    document.getElementById('resetPwdModal').addEventListener('show.bs.modal', function (e) {
        const btn = e.relatedTarget;
        document.getElementById('resetUserId').value         = btn.dataset.userid;
        document.getElementById('resetUserEmail').textContent = btn.dataset.email;
    });

    // Populate edit phone modal
    document.getElementById('editPhoneModal').addEventListener('show.bs.modal', function (e) {
        const btn = e.relatedTarget;
        document.getElementById('editPhoneUserId').value      = btn.dataset.userid;
        document.getElementById('editPhoneEmail').textContent  = btn.dataset.email;
        document.getElementById('editPhoneInput').value        = btn.dataset.phone !== '—' ? btn.dataset.phone : '';
    });
</script>
}
